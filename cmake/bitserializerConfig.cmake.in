@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# By default only the core package is requested. Archives are enabled explicitly:
#   find_package(bitserializer CONFIG REQUIRED COMPONENTS json rapidjson)
foreach(_component IN LISTS bitserializer_FIND_COMPONENTS)
    if(_component STREQUAL "json")
        set(bitserializer_json_FOUND @BUILD_JSON_ARCHIVE@)
    elseif(_component STREQUAL "csv")
        set(bitserializer_csv_FOUND @BUILD_CSV_ARCHIVE@)
    elseif(_component STREQUAL "msgpack")
        set(bitserializer_msgpack_FOUND @BUILD_MSGPACK_ARCHIVE@)
    elseif(_component STREQUAL "rapidjson")
        if(@BUILD_RAPIDJSON_ARCHIVE@)
            if(bitserializer_FIND_REQUIRED_rapidjson)
                find_dependency(RapidJSON CONFIG REQUIRED)
                set(bitserializer_rapidjson_FOUND TRUE)
            else()
                find_package(RapidJSON CONFIG QUIET)
                set(bitserializer_rapidjson_FOUND ${RapidJSON_FOUND})
            endif()
        else()
            set(bitserializer_rapidjson_FOUND FALSE)
        endif()
    elseif(_component STREQUAL "pugixml")
        if(@BUILD_PUGIXML_ARCHIVE@)
            if(bitserializer_FIND_REQUIRED_pugixml)
                find_dependency(pugixml CONFIG REQUIRED)
                set(bitserializer_pugixml_FOUND TRUE)
            else()
                find_package(pugixml CONFIG QUIET)
                set(bitserializer_pugixml_FOUND ${pugixml_FOUND})
            endif()
        else()
            set(bitserializer_pugixml_FOUND FALSE)
        endif()
    elseif(_component STREQUAL "rapidyaml")
        if(@BUILD_RAPIDYAML_ARCHIVE@)
            if(bitserializer_FIND_REQUIRED_rapidyaml)
                find_dependency(ryml CONFIG REQUIRED)
                set(bitserializer_rapidyaml_FOUND TRUE)
            else()
                find_package(ryml CONFIG QUIET)
                set(bitserializer_rapidyaml_FOUND ${ryml_FOUND})
            endif()
        else()
            set(bitserializer_rapidyaml_FOUND FALSE)
        endif()
    else()
        set(bitserializer_${_component}_FOUND FALSE)
        if(bitserializer_FIND_REQUIRED_${_component})
            message(FATAL_ERROR "Unknown BitSerializer component: ${_component}")
        endif()
    endif()
endforeach()

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
check_required_components("@PROJECT_NAME@")
