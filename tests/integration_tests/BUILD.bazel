# The tests use dev-only dependencies (googletest, PugiXml, RapidYAML), so they
# are excluded from wildcard builds of the module. The CI runs this suite
# explicitly; a consumer can still build @bitserializer//... without dev deps.
test_suite(
    name = "all_tests",
    tags = ["manual"],
    tests = [
        ":convert_api_tests",
        ":csv_archive_tests",
        ":json_archive_tests",
        ":msgpack_archive_tests",
        ":pugixml_archive_tests",
        ":rapidyaml_archive_tests",
    ],
)
