{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "bitserializer",
  "version": "0.85.0",
  "homepage": "https://github.com/PavelKisliak/BitSerializer",
  "description": "Multi-format serialization library for C++17: JSON/JSONC, CSV and MsgPack (no mandatory third-party dependencies; optional fast_float acceleration), plus XML and YAML",
  "dependencies": [
    "rapidjson",
    "pugixml",
    "ryml",
    "gtest",
    "nlohmann-json",
    "fast-float"
  ],
  "builtin-baseline": "9eec002df1cd109f8f104cd966a763daf9751489",
  "vcpkg-configuration": {
    "overlay-triplets": [
      "./cmake/vcpkg/triplets"
    ]
  }
}
